# Normalize text handling so CRLF/LF noise and binary diffs stay out of history.
* text=auto

# Source, docs, config: LF in the repository.
*.md      text eol=lf
*.mjs     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.gitignore    text eol=lf
*.gitattributes text eol=lf
LICENSE   text eol=lf

# Windows batch files must keep CRLF so cmd.exe parses them reliably.
*.cmd     text eol=crlf
*.bat     text eol=crlf

# Binary assets: never diff or convert.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.pdf     binary
*.zip     binary
*.exe     binary
*.dll     binary
*.node    binary
